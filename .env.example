# git-taintedd (server) — GT_* config (spec §11)
# GT_DB_DRIVER selects the model.Store implementation: sqlite (default) or mysql.
GT_DB_DRIVER=sqlite
# sqlite driver: path to the DB file.
GT_SQLITE_PATH=/data/git-tainted.db
# mysql driver: DSN. multiStatements=true (multi-statement migrations),
# parseTime=false (timestamps are BIGINT unix-ns), and clientFoundRows=true
# (matched-rows UPDATE semantics) are REQUIRED.
# GT_MYSQL_DSN=user:pass@tcp(127.0.0.1:3306)/git_tainted?multiStatements=true&parseTime=false&clientFoundRows=true

# HTTP server (HTTP/1.1 + h2c on a single cleartext listener)
GT_LISTEN_ADDR=127.0.0.1:8080

# Scheduler / sync
GT_SYNC_CONCURRENCY=4
GT_SYNC_DEFAULT_INTERVAL_NS=300000000000
GT_SCHEDULER_TICK_NS=5000000000
GT_STALENESS_BUDGET_NS=3600000000000

# Git runner
GT_GIT_BIN=git
GT_GIT_TIMEOUT_NS=60000000000
# Colon-separated allowed git transport schemes (e.g. https:ssh).
GT_PROTOCOL_ALLOWLIST=https:ssh
# Colon-separated allowed host patterns; empty = allow all.
GT_HOST_ALLOWLIST=

# Observability
GT_LOG_LEVEL=info
# Dedicated Prometheus listener. Empty (default) = metrics DISABLED.
# Set to an address to enable, e.g. 127.0.0.1:9090
GT_METRICS_ADDR=
# Expose /debug/pprof/* on the API listener. Default false.
# Enable only in controlled/dev environments.
GT_PPROF_ENABLED=false

# Verify hot-path cache (control-plane design spec §4). Otter-backed Store
# decorator over the verify reads, invalidated by per-remote generation counters
# bumped strictly after each write commits. Disabling returns the bare store.
GT_CACHE_ENABLED=true
# Max entries per logical Otter cache (size-based eviction).
GT_CACHE_MAX_ENTRIES=100000
# Staleness backstop in unix-ns, independent of the immediate generation
# invalidation. 0 disables the TTL.
GT_CACHE_TTL_NS=60000000000

# Control-plane auth (design spec §2). Gates ONLY the five mutating control
# endpoints (create/update/delete remote, trigger sync, ack taint event).
# Reads (verify, all GETs) and health probes are NEVER gated.
# Mode: none (default) | apikey | basic | jwks. Unknown value = fatal at startup.
GT_AUTH_MODE=none
# apikey mode: comma-separated raw keys (SHA-256-hashed at load, cleartext dropped)
# and/or comma-separated lowercase-hex SHA-256 digests. At least one key required.
# Client sends `Authorization: Bearer <key>` or `X-API-Key: <key>`.
# GT_API_KEYS=
# GT_API_KEYS_SHA256=
# basic mode: comma-separated user:bcrypt-hash entries (htpasswd-style; raw
# passwords never in the env). At least one entry required. Client sends HTTP Basic.
# GT_BASIC_AUTH=alice:$2a$10$....,bob:$2a$10$....
# jwks mode: all three of URL/issuer/audience are required. GT_JWT_ALGS is an
# allowlist (default RS256,ES256); `none` and HS* are always rejected.
# GT_JWKS_URL=https://idp.example/.well-known/jwks.json
# GT_JWT_ISSUER=https://idp.example/
# GT_JWT_AUDIENCE=git-tainted
# GT_JWT_ALGS=RS256,ES256

# Seed-on-bootstrap (peer seeding). When GT_SEED_SERVERS is set AND this server's
# remotes table is EMPTY (incl. soft-deleted), it bootstraps its baseline from one
# or more peer git-tainted servers — adopting their remotes, current tag
# projections, and taint history — instead of starting blind. It reuses the peers'
# open read endpoints (no credentials needed) and rebuilds its own hash-chain.
# GT_SEED_QUORUM controls trust: 1 = trust a single peer (convenience); N>1
# requires >=N peers to AGREE before adopting any fact (corroboration). Disagreeing
# tags are quarantined (skipped + logged). Independence of the listed peers is the
# operator's responsibility (the quorum counts URLs, not operators). The whole seed
# commits in ONE transaction; a crash rolls back so the next boot re-seeds cleanly.
# Empty GT_SEED_SERVERS (default) = feature OFF.
# GT_SEED_SERVERS=https://peer-a.example,https://peer-b.example
GT_SEED_QUORUM=1
# Optional comma-separated glob allowlist on adopted remote URLs (default = all).
# GT_SEED_REMOTES=https://github.com/myorg/*
# Max in-flight peer HTTP requests (bounded fan-out).
GT_SEED_CONCURRENCY=8
# Per-request HTTP deadline in unix-ns (default 30s).
GT_SEED_TIMEOUT_NS=30000000000
# Allow plaintext http:// to non-loopback peers (e.g. h2c-fronted fleet peers).
GT_SEED_INSECURE=false
# Fail-loud ceilings on the single seed transaction (abort rather than hold the
# writer for an unbounded import).
GT_SEED_MAX_REMOTES=5000
GT_SEED_MAX_OBSERVATIONS=200000
# Per-resource pagination safety bound (a malformed peer can't drive an unbounded
# fetch loop).
GT_SEED_MAX_PAGES=10000

# git-tainted (CLI)
GT_SERVER=http://127.0.0.1:8080
