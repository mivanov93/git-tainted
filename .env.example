# git-taintedd (server) — GT_* config (spec §11)
# GT_DB_DRIVER selects the model.Store implementation: sqlite (default) or mysql.
GT_DB_DRIVER=sqlite
# sqlite driver: path to the DB file.
GT_SQLITE_PATH=/data/git-tainted.db
# mysql driver: DSN. multiStatements=true (multi-statement migrations),
# parseTime=false (timestamps are BIGINT unix-ns), and clientFoundRows=true
# (matched-rows UPDATE semantics) are REQUIRED.
# GT_MYSQL_DSN=user:pass@tcp(127.0.0.1:3306)/git_tainted?multiStatements=true&parseTime=false&clientFoundRows=true
GT_LISTEN_ADDR=127.0.0.1:8080
GT_SYNC_CONCURRENCY=4
GT_SYNC_DEFAULT_INTERVAL_NS=300000000000
GT_SCHEDULER_TICK_NS=5000000000
GT_STALENESS_BUDGET_NS=900000000000
GT_GIT_BIN=git
GT_GIT_TIMEOUT_NS=60000000000
GT_PROTOCOL_ALLOWLIST=https:ssh
GT_HOST_ALLOWLIST=
GT_LOG_LEVEL=info
GT_METRICS_ADDR=127.0.0.1:9090

# git-tainted (CLI)
GT_SERVER=http://127.0.0.1:8080
